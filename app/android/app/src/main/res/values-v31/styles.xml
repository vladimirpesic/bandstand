<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ draws the system splash before the window background: give
         it the brand too. The animated icon is the adaptive launcher, so the
         same mark appears at every stage of startup. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
